# ============================================================
# NISWARA — environment template for server-side / admin tooling
# ============================================================
#
# The deployed frontend is a static site with NO build step and
# NO server, so it cannot read a .env file — its public config
# lives in config.js (see config.example.js for why that's safe).
#
# This file is for anything that runs OUTSIDE the browser later:
# a local seed/admin script, a CI job, a future serverless
# function, etc. Copy this to .env (gitignored) and fill it in.

# Same values as config.js — safe to duplicate here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Project Settings → API → Project API keys → "service_role" "secret"
# FULL ADMIN ACCESS — bypasses every Row Level Security policy.
# Server-side / local admin scripts ONLY. Never log it, never send
# it to the browser, never commit it.
SUPABASE_SERVICE_ROLE_KEY=
